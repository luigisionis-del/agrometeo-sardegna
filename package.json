{
  "name": "agrometeo-sardegna",
  "version": "0.3.0",
  "private": true,
  "description": "Agrometeo Sardegna - DSS agrometeorologico (Rust + Tauri)",
  "author": "Luigi Sionis",
  "license": "MIT",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:appimage": "tauri build --bundles appimage",
    "icons": "tauri icon src-tauri/icons/sorgente.png",
    "vendor": "node scripts/vendor.mjs",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "android:apk": "tauri android build --apk --target aarch64",
    "android:apk:tv": "tauri android build --apk --target armv7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "chart.js": "4.4.7",
    "leaflet": "1.9.4"
  },
  "optionalDependencies": {
    "@tauri-apps/cli-linux-x64-gnu": "2.12.3"
  }
}
